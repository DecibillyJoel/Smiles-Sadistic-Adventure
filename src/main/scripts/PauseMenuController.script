local HUP = hash("UP")
local HDOWN = hash("DOWN")
local HLEFT = hash("LEFT")
local HRIGHT = hash("RIGHT")
local HPAUSE = hash("PAUSE")
local HDASH = hash("DASH")
local HUP2 = hash("W")
local HDOWN2 = hash("S")
local HLEFT2 = hash("A")
local HRIGHT2 = hash("D")
local HPAUSE2 = hash("PAUSE2")
local HDASH2 = hash("DASH2")
local HEXIT = hash("EXIT")
local labels = {"#Resume","#Quit"}

local TIME = require("main.modules.time")

function init(self)
	self.TimeStart = TIME:init()
	self.Selection = 0
	self.Countdown = false
	msg.post(".","acquire_input_focus")
	msg.post("#Countdown","disable")
	go.set("#Resume","color",vmath.vector4(0,1,0,1))
end

function update(self, dt)
	dt = TIME:update()
	if not dt then
		return
	end
	if self.Countdown then
		self.Countdown = self.Countdown - dt
		if self.Countdown > 0 then
			label.set_text("#Countdown",tostring(math.ceil(self.Countdown)))
		else
			go.delete()
			paused = false
		end
	end
end

function on_input(self, action_id, action)
	if not self.Countdown and (action.pressed or action.repeated) then
		if action_id == HUP or action_id == HUP2 or action_id == HDOWN or action_id == HDOWN2 then
			local prev = self.Selection
			self.Selection = 1 - prev
			go.set(labels[prev + 1],"color",vmath.vector4(1,1,1,1))
			go.set(labels[self.Selection + 1],"color",vmath.vector4(0,1,0,1))
		elseif action_id == HPAUSE or action_id == HPAUSE2 or action_id == HDASH or action_id == HDASH2 or action_id == HEXIT then
			if self.Selection == 0 or action_id == HEXIT then
				self.Countdown = 3
				msg.post("#Resume","disable")
				msg.post("#Quit","disable")
				msg.post("#Pause","disable")
				msg.post("#Countdown","enable")
			else
				paused = false
				msg.post("main:/CollectionController#script","menu")
			end
		end
	end
end

function final(self)
	msg.post(".", "release_input_focus")
end
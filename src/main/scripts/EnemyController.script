local HWEAPONBASIC = hash("basic")
local HWEAPONGUN = hash("gun")
local HWEAPONLASER = hash("laser")
local HWEAPONBOOMERANG = hash("boomerang")
local HDIRECTIONLEFT = hash("left")
local HDIRECTIONRIGHT = hash("right")
local HATTACKDIRECT = hash("direct")
local HATTACKTARGET = hash("target")
local HSTATESPAWN = hash("spawn")
local HSTATEATTACK = hash("attack")
local HSTATEEXIT = hash("exit")
local HTWEENLINEAR = hash("linear")
local HTWEENSINE = hash("sine")
local HTWEENSINEIN = hash("sinein")
local HTWEENSINEOUT = hash("sineout")
local HTWEENQUAD = hash("quad")
local HTWEENQUADIN = hash("quadin")
local HTWEENQUADOUT = hash("quadout")
local HTWEENQUART = hash("quart")
local HTWEENQUARTIN = hash("quartin")
local HTWEENQUARTOUT = hash("quartout")
local HTWEENBINARY = hash("binary")
local HACTIONSET = hash("action_set")
local HACTIONCOLLIDE = hash("collision_response")
local HGROUP = hash("enemy")
local function EaseLinear(a,b,t)
	return a+(b-a)*t
end
local rad90 = math.pi/2
local function EaseInOutSine(a,b,t)
	return a+(b-a)*math.sin(t*rad90)
end
local rad45 = math.pi/4
local sinrad45 = math.sin(rad45)
local rad45scale = 1/sinrad45
local rad45scale2 = 1/(1-sinrad45)
local function EaseInSine(a,b,t)
	return a+(b-a)*math.sin(t*rad45)*rad45scale
end
local function EaseOutSine(a,b,t)
	return a+(b-a)*((math.sin(t*rad45+rad45)-sinrad45)*rad45scale2)
end
local function EaseInOutQuad(a,b,t)
	t = t*2
	if t < 1 then
		return (b-a)*.5*t^2+a
	else
		t = t - 1
		return -(b-a)*.5*(t*(t-2)-1) + a
	end
end
local function EaseInQuad(a,b,t)
	return (b-a)*t^2 + a
end
local function EaseOutQuad(a,b,t)
	return -(b-a)*t*(t-2) + a
end
local function EaseInOutQuart(a,b,t)
	t = t*2
	if t < 1 then
		return (b-a)*.5*t^4 + a
	else
		return -(b-a)*.5*((t-2)^4 - 2) + a
	end
end
local function EaseInQuart(a,b,t)
	return (b-a)*t^4 + a
end
local function EaseOutQuart(a,b,t)
	return -(b-a)*((t-1)^4 - 1) + a
end
local function EaseBinary(a,b,t)
	return a + (b-a)*math.floor(t + 0.5)
end
local tweens = {
	[HTWEENLINEAR] = EaseLinear,
	[HTWEENSINE] = EaseInOutSine,
	[HTWEENSINEIN] = EaseInSine,
	[HTWEENSINEOUT] = EaseOutSine,
	[HTWEENQUAD] = EaseInOutQuad,
	[HTWEENQUADIN] = EaseInQuad,
	[HTWEENQUADOUT] = EaseOutQuad,
	[HTWEENQUART] = EaseInOutQuart,
	[HTWEENQUARTIN] = EaseInQuart,
	[HTWEENQUARTOUT] = EaseOutQuart,
	[HTWEENBINARY] = EaseBinary
}
local tweensFlat = {
	EaseLinear,
	EaseInOutSine,
	EaseInSine,
	EaseOutSine,
	EaseInOutQuad,
	EaseInQuad,
	EaseOutQuad,
	EaseInOutQuart,
	EaseInQuart,
	EaseOutQuart,
	EaseBinary
}
local hitboxes = {"#HitboxBasic","#HitboxGunLeft","#HitboxGunRight","#HitboxLaserLeft","#HitboxLaserRight"}
local function updatePositionAndRotation(self,cancel)
	local percent = self.TimePosition/(self.TimeLength == 0 and self.TimePosition or self.TimeLength)
	local drift = vmath.vector3(0,0,0)
	local rrift = 0
	local target = self.Attack == HATTACKDIRECT and vmath.vector3(0,0,0) or go.get_position("/Character")
	local position,rotation
	do
		local a,b,c,d,t = self.StartPosition,self.StartPosition+self.Distance,self.StartRotation,self.StartRotation+self.RotateBy,percent
		if self.State == HSTATEEXIT then
			a,b,c,d,t = b,a,d,c,1-t
		elseif self.State == HSTATEATTACK then
			t = 0
		end
		position = tweens[self.Tween](a,b,t)
		rotation = tweens[self.Tween](c,d,t)
	end
	if self.Weapon == HWEAPONGUN or self.Weapon == HWEAPONLASER then
		local driftPercent = self.State == HSTATEEXIT and 1 or (percent+(self.State == HSTATEATTACK and 0 or -1))
		rrift = self.AttackRotate*driftPercent
		drift = self.AttackDrift*driftPercent
	end
	position = self.Offset + drift + target + position
	rotation = self.RotateOffset + rrift + rotation
	if not cancel then
		self.TargetPosition = target
		go.set_position(position)
		go.set_rotation(vmath.quat_rotation_z(math.rad(rotation)))
	end
	return position,rotation
end

go.property("Weapon",hash("basic"))
go.property("Direction",hash("left"))
go.property("Attack",hash("direct"))
go.property("StartPosition",vmath.vector3(2100,540,0))
go.property("Distance",vmath.vector3(-2280,0,0))
go.property("Offset",vmath.vector3(0,0,0))
go.property("StartRotation",0)
go.property("RotateBy",0)
go.property("RotateOffset",0)
go.property("Tween",hash("quartout"))
go.property("SpawnTime",1)
go.property("ExitTime",1)
go.property("AttackTime",1)
go.property("AttackFrequency",0.33)
go.property("AttackDrift",vmath.vector3(-150,0,0))
go.property("AttackRotate",0)
go.property("PropertyMutation",vmath.vector4(0,0,0,0))

local TIME = require("main.modules.time")

function init(self)
	self.TimeStart = TIME:init()
	self.Weapon = go.get("#script","Weapon")
	self.Direction = go.get("#script","Direction")
	self.Attack = go.get("#script","Attack")
	self.StartPosition = go.get("#script","StartPosition")
	self.Distance = go.get("#script","Distance")
	self.Offset = go.get("#script","Offset")
	self.StartRotation = go.get("#script","StartRotation")
	self.RotateBy = go.get("#script","RotateBy")
	self.RotateOffset = go.get("#script","RotateOffset")
	self.Tween = go.get("#script","Tween")
	self.SpawnTime = math.max(0.02,go.get("#script","SpawnTime"))
	self.ExitTime = math.max(0.02,go.get("#script","ExitTime"))
	self.AttackTime = math.max(0.02,go.get("#script","AttackTime"))
	self.AttackFrequency = math.max(0.02,go.get("#script","AttackFrequency"))
	self.AttackDrift = go.get("#script","AttackDrift")
	self.AttackRotate = go.get("#script","AttackRotate")
	self.PropertyMutation = go.get("#script","PropertyMutation")
	self.State = HSTATESPAWN
	self.TimePosition = 0
	self.TimeLength = self.SpawnTime
	self.TargetPosition = self.Attack == HATTACKDIRECT and vmath.vector3(0,0,0) or go.get_position("/Character")
	self.AttackNow = false
	local enemyName = (self.Weapon == HWEAPONBASIC or self.Weapon == HWEAPONBOOMERANG) and "Basic" or ((self.Weapon == HWEAPONGUN and "Gun" or "Laser")..(self.Direction == HDIRECTIONLEFT and "Left" or "Right"))
	local hitboxName = "#Hitbox"..enemyName
	local spriteName = "Enemy"..enemyName
	for i,v in pairs(hitboxes) do
		if v ~= hitboxName then
			msg.post(v,"disable")
		end
	end
	msg.post("#sprite","play_animation",{id = hash(spriteName)})
	updatePositionAndRotation(self)
end
function update(self, dt)
	dt = TIME:update()
	if paused or not dt then
		return
	end
	local extra = math.max(0,self.TimePosition + dt - self.TimeLength)
	local edt = dt - extra
	local prev = self.TimePosition
	local cur = self.TimePosition + edt
	self.TimePosition = cur
	if self.PropertyMutation.x > 0 then
		if self.PropertyMutation.x == 1 then
			if self.State == HSTATEATTACK then
				if self.AttackNow then
					self.PropertyMutation.w = math.max(0,math.min(1,self.PropertyMutation.w))
					self.PropertyMutation.y = math.max(1,math.min(#tweensFlat,math.floor(self.PropertyMutation.y)))
				end
				local t = tweensFlat[self.PropertyMutation.y](self.PropertyMutation.w,1,math.max(0,math.min(1,cur/self.TimeLength)))
				self.RotateOffset = (self.RotateOffset + edt*t*self.PropertyMutation.z)%360
			end
		end
	end
	if self.State == HSTATEATTACK then
		local freq = self.AttackFrequency
		if (prev%freq >= cur%freq or edt/freq >= 1 or self.AttackNow) and edt > 0 then
			local prev = self.AttackNow or prev
			self.AttackNow = false
			local firstTime = freq*math.floor(prev/freq)+freq
			local fdt = math.max(0,cur - firstTime)
			local attacks = math.floor(fdt/freq)+1
			if self.Weapon == HWEAPONLASER then
				if math.floor(cur/freq)%2 == 0 then
					self.TimePosition = prev
					local position = updatePositionAndRotation(self,true)
					local rotation = 0
					self.TimePosition = cur
					if self.Direction == HDIRECTIONLEFT then
						rotation = 180
					end
					local rad = math.rad(rotation)
					local id = factory.create("/DeathStar#factory",vmath.vector3(math.cos(rad),math.sin(rad),0)*74,vmath.quat_rotation_z(rad),{
						TimePosition = math.max(0.001,fdt%freq),
						TimeLength = freq
					},1)
					msg.post(id,"set_parent",{parent_id = go.get_id(),keep_world_transform = 0})
				end
			else
				local roffset = self.Direction == HDIRECTIONLEFT and 180 or 0
				for i = 0,attacks - 1 do
					local time = firstTime + freq*i
					self.TimePosition = time
					local position,rotation = updatePositionAndRotation(self,true)
					rotation = rotation + roffset
					local rad = math.rad(rotation)
					factory.create("/USIndustrialMilitaryComplex#factory",vmath.vector3(0,0,0),vmath.quat_rotation_z(0),{
						Rotation = rotation,
						StartPosition = position + vmath.vector3(math.cos(rad),math.sin(rad),0)*85,
						Headstart = fdt - freq*i
					},1)
				end
				self.TimePosition = cur
			end
		end
	end
	if self.TimePosition == self.TimeLength then
		if self.State == HSTATESPAWN then
			if self.Weapon == HWEAPONBASIC then
				go.delete()
			else
				self.StartPosition = self.StartPosition + self.Distance
				self.Distance = -self.Distance
				self.StartRotation = self.StartRotation + self.RotateBy
				self.RotateBy = -self.RotateBy
				self.AttackNow = prev - self.TimeLength
				self.TimePosition = extra
				self.TimeLength = self.Weapon == HWEAPONBOOMERANG and self.ExitTime or self.AttackTime
				self.State = self.Weapon == HWEAPONBOOMERANG and HSTATEEXIT or HSTATEATTACK
			end
		elseif self.State == HSTATEATTACK then
			local pos,rotation = updatePositionAndRotation(self,true)
			local px,py = pos.x,pos.y
			self.TimePosition = extra
			self.TimeLength = self.ExitTime
			self.State = HSTATEEXIT
			local dx,dy = self.Distance.x,self.Distance.y
			local tx = (dx < 0 and -180 or ((dx > 0) or ((2100 - px) < (px - -180))) and 2100 or -180)
			local ty = (dy < 0 and -180 or ((dy > 0) or ((1260 - py) < (py - -180))) and 1260 or -180)
			if dx == 0 and dy == 0 then
				local sx,sy = tx-px,ty-py
				if math.abs(sx) <= math.abs(sy) then
					sy = self.StartPosition.y
				else
					sx = self.StartPosition.x
				end
				self.Distance = vmath.vector3(sx,sy,0)
			else
				local sx,sy = (tx-px)/dx,(ty-py)/dy
				local s = (sx <= sy or sy*0 ~= 0) and sx or sy
				if s > 1 and s*0 == 0 then
					self.Distance = self.Distance*s
				end
			end
		elseif self.State == HSTATEEXIT then
			go.delete()
		end
	end
	updatePositionAndRotation(self)
end

function on_message(self, message_id, message, sender)
	if paused then
		return
	end
	if message_id == HACTIONSET then
		for i,v in pairs(message) do
			pcall(go.set,"#script",i,v)
			self[i] = v
		end
	elseif message_id == HACTIONCOLLIDE then
		msg.post("/HealthAndScore#script","action_hurt",{typeof = HGROUP})
	end
end